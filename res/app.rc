#pragma code_page(65001)
1 ICON "app.ico"
// The tray icon, no background like Windows' own: white on a dark taskbar, near black on a light one.
2 ICON "tray-dark.ico"
3 ICON "tray-light.ico"
1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION 0,1,5,0
PRODUCTVERSION 0,1,5,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "NF"
      VALUE "FileDescription", "NF Switcher"
      VALUE "FileVersion", "0.1.5"
      VALUE "InternalName", "nf-switcher"
      VALUE "OriginalFilename", "nf-switcher.exe"
      VALUE "ProductName", "NF Switcher"
      VALUE "ProductVersion", "0.1.5"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
